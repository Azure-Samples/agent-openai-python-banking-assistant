    "existingApplicationInsightsConnectionString": { "value": "${EXISTING_APPLICATION_INSIGHTS_CONNECTION_STRING=}" },
    "allowMixedObservabilityWorkspaces":    { "value": "${ALLOW_MIXED_OBSERVABILITY_WORKSPACES=false}" },
    "hubIntegrationEgressNextHopIp":             { "value": "${HUB_INTEGRATION_EGRESS_NEXT_HOP_IP=}" },
