    "existingPrivateDnsZoneAiServicesResourceId":      { "value": "${EXISTING_PRIVATE_DNS_ZONE_AISERVICES_RESOURCE_ID=}" },
    "existingPrivateDnsZoneSearchResourceId":          { "value": "${EXISTING_PRIVATE_DNS_ZONE_SEARCH_RESOURCE_ID=}" },
    "existingPrivateDnsZoneCosmosResourceId":          { "value": "${EXISTING_PRIVATE_DNS_ZONE_COSMOS_RESOURCE_ID=}" },
    "existingPrivateDnsZoneBlobResourceId":            { "value": "${EXISTING_PRIVATE_DNS_ZONE_BLOB_RESOURCE_ID=}" },
    "existingPrivateDnsZoneKeyVaultResourceId":        { "value": "${EXISTING_PRIVATE_DNS_ZONE_KEYVAULT_RESOURCE_ID=}" },
    "existingPrivateDnsZoneAppConfigResourceId":       { "value": "${EXISTING_PRIVATE_DNS_ZONE_APPCONFIG_RESOURCE_ID=}" },
    "existingPrivateDnsZoneContainerAppsResourceId":   { "value": "${EXISTING_PRIVATE_DNS_ZONE_CONTAINERAPPS_RESOURCE_ID=}" },
    "existingPrivateDnsZoneAcrResourceId":             { "value": "${EXISTING_PRIVATE_DNS_ZONE_ACR_RESOURCE_ID=}" },
    "existingPrivateDnsZoneAzureMonitorResourceId":    { "value": "${EXISTING_PRIVATE_DNS_ZONE_AZUREMONITOR_RESOURCE_ID=}" },
    "existingPrivateDnsZoneOmsOpsInsightsResourceId":  { "value": "${EXISTING_PRIVATE_DNS_ZONE_OMSOPSINSIGHTS_RESOURCE_ID=}" },
    "existingPrivateDnsZoneOdsOpsInsightsResourceId":  { "value": "${EXISTING_PRIVATE_DNS_ZONE_ODSOPSINSIGHTS_RESOURCE_ID=}" },
