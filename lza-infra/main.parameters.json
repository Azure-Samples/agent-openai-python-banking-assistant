    "speechServiceSku":                     { "value": "S0" },
    "deployDocumentIntelligence":           { "value": "true" },
    "documentIntelligenceLocation":         { "value": "${AZURE_DOCUMENT_INTELLIGENCE_LOCATION=eastus}" },
    "deployStorageAccount":                 { "value": "${DEPLOY_STORAGE_ACCOUNT=true}" },
    "greenFieldDeployment":                 { "value": "${GREEN_FIELD_DEPLOYMENT=true}" },
    "deployJumpbox":                        { "value": "true" },
    "deployBastion":                        { "value": "true" },
    "deployNatGateway":                     { "value": "true" },
    "existingJumpboxResourceId":            { "value": "${EXISTING_JUMPBOX_RESOURCE_ID=}" },
    "existingBastionResourceId":            { "value": "${EXISTING_BASTION_RESOURCE_ID=}" },
