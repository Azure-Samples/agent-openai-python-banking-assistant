    "deployVM":                             { "value": "true" },
    "deploySoftware":                       { "value": "true" },
    "deployPostgres":                       { "value": "${DEPLOY_POSTGRES=false}" },

    "aiFoundryAccountName":                  { "value": null },
    "aiFoundryProjectName":                  { "value": null },
    "aiFoundryProjectDisplayName":           { "value": "Banking Assistant Project" },
    "aiFoundryProjectDescription":           { "value": "AI Foundry project for the multi-agent home banking assistant" },    
    "aiFoundryStorageAccountName":           { "value": null },
    "aiFoundryStorageSku":                 { "value": "Standard_LRS" },
    "aiFoundrySearchServiceName":            { "value": null },
    "aiFoundryCosmosDbName":                 { "value": null },
    "bingSearchName":                        { "value": null },  
    "appConfigName":                         { "value": null },
    "appInsightsName":                       { "value": null },
    "containerEnvName":                      { "value": null },
    "containerRegistryName":                 { "value": null },
    "conversationContainerName":             { "value": null },
    "dataIngestContainerAppName":            { "value": null },
    "datasourcesContainerName":              { "value": null },
    "dbAccountName":                         { "value": null },
    "dbDatabaseName":                        { "value": "chatkit" },
    "frontEndContainerAppName":              { "value": null },
    "keyVaultName":                          { "value": null },
    "logAnalyticsWorkspaceName":             { "value": null },
    "searchServiceName":                     { "value": null },
    "speechServiceName":                     { "value": null },
    "solutionStorageAccountName":            { "value": null },

    "vmAdminPassword":                       {"value": "$(secretOrRandomPassword)"},  
    "vmSize":                                { "value": "${AZURE_VM_SIZE=Standard_D2as_v7}" },

    "useCMK":                                { "value": "false" },
    "useExistingVNet":                       { "value": "${USE_EXISTING_VNET}" },  
    "deploySubnets":                         { "value": "${DEPLOY_SUBNETS}" },  
    "sideBySideDeploy":                      { "value": "${SIDE_BY_SIDE}" }, 
    "existingVnetResourceId":                { "value": "${EXISTING_VNET_RESOURCE_ID}" },
    "policyManagedPrivateDns":               { "value": "${POLICY_MANAGED_PRIVATE_DNS=false}" },     

    "modelDeploymentList":{
      "value": [
        {
          "name": "gpt-4.1",
          "model": {
            "format": "OpenAI",
            "name": "gpt-4.1",
            "version": "2025-04-14"
          },
          "sku": {
            "name": "GlobalStandard",
            "capacity": 80
          },
          "canonical_name": "CHAT_DEPLOYMENT_NAME",
          "apiVersion": "2025-04-01-preview"
        }
      ]
    },

    "workloadProfiles" : {
      "value": [
        {
          "name": "Consumption",
          "workloadProfileType": "Consumption"
        }
      ]
    },

    "storageAccountContainersList": {
      "value": [
        {
          "name": "content",
          "canonical_name": "STORAGE_CONTAINER_CONTENT"
        }
      ]
    },  

    "databaseContainersList": {
      "value": [
        {
          "name": "threads",
          "canonical_name": "CHATKIT_THREADS_CONTAINER",
          "partitionKey": "/user_id",
          "indexingPolicy": {
            "compositeIndexes": [
              [
                { "path": "/user_id", "order": "Ascending" },
                { "path": "/created_at", "order": "Descending" }
              ]
            ]
          }
        },
        {
          "name": "items",
          "canonical_name": "CHATKIT_ITEMS_CONTAINER",
          "partitionKey": "/user_id",
          "indexingPolicy": {
            "compositeIndexes": [
              [
                { "path": "/user_id", "order": "Ascending" },
                { "path": "/thread_id", "order": "Ascending" },
                { "path": "/created_at", "order": "Descending" }
              ]
            ]
          }
        },
        {
          "name": "attachments",
          "canonical_name": "CHATKIT_ATTACHMENTS_CONTAINER",
          "partitionKey": "/user_id",
          "indexingPolicy": {
            "compositeIndexes": [
              [
                { "path": "/user_id", "order": "Ascending" },
                { "path": "/created_at", "order": "Descending" }
              ]
            ]
          }
        }
      ]
    },

    "containerAppsList": {
      "value": [
        {
          "name": null,
          "external": false,
          "target_port": 8080,
          "service_name": "backend",
          "profile_name": "Consumption",
          "min_replicas": 1,
          "max_replicas": 10,
          "cpu": "1.0",
          "memory": "2.0Gi",
          "dapr_enabled": false,
          "canonical_name": "BACKEND_APP",
          "roles": [
            "CognitiveServicesUser",
            "CognitiveServicesOpenAIUser",
            "AcrPull",
            "CosmosDBBuiltInDataContributor",
            "StorageBlobDataContributor",
            "KeyVaultSecretsUser"
          ]
        },
        {
          "name": null,
          "external": false,
          "target_port": 8080,
          "service_name": "account",
          "profile_name": "Consumption",
          "min_replicas": 1,
          "max_replicas": 10,
          "cpu": "0.5",
          "memory": "1.0Gi",
          "dapr_enabled": false,
          "canonical_name": "ACCOUNT_APP",
          "roles": [
            "AcrPull"
          ]
        },
        {
          "name": null,
          "external": false,
          "target_port": 8080,
          "service_name": "transaction",
          "profile_name": "Consumption",
          "min_replicas": 1,
          "max_replicas": 10,
          "cpu": "0.5",
          "memory": "1.0Gi",
          "dapr_enabled": false,
          "canonical_name": "TRANSACTION_APP",
          "roles": [
            "AcrPull"
          ]
        },
        {
          "name": null,
          "external": false,
          "target_port": 8080,
          "service_name": "payment",
          "profile_name": "Consumption",
          "min_replicas": 1,
          "max_replicas": 10,
          "cpu": "0.5",
          "memory": "1.0Gi",
          "dapr_enabled": false,
          "canonical_name": "PAYMENT_APP",
          "roles": [
            "AcrPull"
          ]
        },
        {
          "name": null,
          "external": true,
          "target_port": 80,
          "service_name": "web",
          "profile_name": "Consumption",
          "min_replicas": 1,
          "max_replicas": 10,
          "cpu": "0.5",
          "memory": "1.0Gi",
          "dapr_enabled": false,
          "canonical_name": "WEB_APP",
          "roles": [
            "AcrPull"
          ]
        }
      ]
    }
